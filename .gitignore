# Keep only what is needed to regenerate the results from a fresh clone:
#   code (retrieval_eval/, run.py), environments (requirements*.txt, .python-version),
#   the LLM response cache (llm_cache/, so LLM steps replay exactly without gateway access),
#   report sources and the final report PDF.
# Everything below is downloaded or regenerated by `python -m retrieval_eval.data.fetch_beir` and `run.py`.

# Python / environments
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
.venv-colbert/
.DS_Store

# Downloaded datasets and old CS410 MP data (root-anchored: retrieval_eval/data/ is code)
/data/
/data_beir/
/archive_mp/

# Large regenerable artefacts: indexes, corpus embeddings
/indexes/
/emb_cache/

# Pipeline outputs (run files, timings, LLM-judge labels, augmented qrels, logs)
/runs/
/timing/
/llm_labels/
/qrels_aug/
/logs/
*.log

# Result tables and summaries written by retrieval_eval.evaluation.*
/results.csv
/results_augmented.csv
/per_query.csv
/paired_tests.csv
/published_comparison.csv
/eval_info.json
/hyde_geometry.json
/examples.md
/RESULT.md
/ndcg10.png
/step0_probe*.txt
/teardown.txt
/main.py

# Report: generated tables/figures and LaTeX build files (report.pdf itself is kept)
/report/tables.tex
/report/hyde_geometry.tex
/report/ndcg10.pdf
/report/hyde_pca.pdf
/report/hyde_scatter.pdf
/report/*.aux
/report/*.bbl
/report/*.blg
/report/*.fdb_latexmk
/report/*.fls
/report/*.out
/report/*.toc
/report/*.synctex.gz
